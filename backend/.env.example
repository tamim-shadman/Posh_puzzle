# Posh Puzzle Backend Environment Configuration Example
PORT=5001
NODE_ENV=development

# Database Configuration (Leave empty to use automatic Enterprise In-Memory fallback)
MONGO_URI=mongodb://127.0.0.1:27017/posh_puzzle

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=7d

# Allowed Client Origin (CORS)
CLIENT_URL=http://localhost:3000,http://localhost:3001
