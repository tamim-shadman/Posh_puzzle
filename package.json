{
  "name": "posh_puzzle",
  "version": "1.0.0",
  "description": "An advanced e-commerce multivendor platform",
  "main": "backend/server.js",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm --prefix backend run dev\" \"npm --prefix frontend start\"",
    "server": "npm --prefix backend run dev",
    "client": "npm --prefix frontend start",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "seed": "npm --prefix backend run seed",
    "start": "node backend/server.js",
    "build": "npm --prefix frontend run build"
  },
  "repository": {
    "type": "git",
    "url": "Posh_puzzle"
  },
  "author": "Backbencher's Binary Solution",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
